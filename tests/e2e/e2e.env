# e2e 的 compose 變數（tests/e2e/compose.yml；`python -m tests.e2e.stack` 把它們放進 compose 子程序的
# 環境，蓋過呼叫端 shell 裡的同名變數，見 stack.py）。
#
# 與同一台機器上的試跑環境並存（M4 票 34）：五個 host port 都不是套件的預設（tests/unit/test_e2e_stack.py
# 守著），也避開了試跑環境常改成的 18xxx；/data 與四份 /config 都是這個專案自己的 named volume，
# `down --volumes` 就清乾淨。harness.py 由這裡讀 port。
COMPOSE_PROFILES=jellyfin,qbittorrent,prowlarr
# named volume，不是 bind mount：發佈名很長，Windows 宿主的 260 字元路徑上限放不下（票 12 實測）。
DATA_ROOT=berth-e2e-data
# 產品 compose 以 `${CONFIG_ROOT:?}` 要求它有值；四個 /config 掛載在 compose.yml 全部換成 named
# volume，這個值不會被掛到任何地方。
CONFIG_ROOT=unused-every-config-mount-is-a-volume
BERTH_PORT=28383
JELLYFIN_PORT=28096
QBITTORRENT_WEBUI_PORT=28080
QBITTORRENT_BT_PORT=26881
PROWLARR_PORT=29696
PUID=1000
PGID=1000
UMASK=022
TZ=Etc/UTC
