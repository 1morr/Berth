# Berth 部署套件的設定。複製成 .env 後 `docker compose up -d`。
# 這裡沒有任何秘密：API key 與各服務的密碼都在 Berth 的精靈裡設定，存進 /config 的資料庫。

# 媒體根。四個容器都掛這一個目錄，下載目錄與媒體庫都在它底下。
# 硬鏈接只能在同一個檔案系統內完成，所以只掛這一個根，不要把下載與媒體庫分開掛
# （分開掛會得到 EXDEV，Berth 的 Route 檢查會直接擋下來）。
#   Linux:   DATA_ROOT=/srv/berth/data
#   Windows: DATA_ROOT=C:\Berth\data
# 預設的相對路徑是 compose 檔旁邊的 ./data，第一次試跑不用改任何東西。
DATA_ROOT=./data

# 四個服務的設定目錄的父目錄；底下會出現 berth / qbittorrent / jellyfin / prowlarr。
# 備份 Berth 就是備份 ${CONFIG_ROOT}/berth。
#   Linux:   CONFIG_ROOT=/srv/berth/config
#   Windows: CONFIG_ROOT=C:\Berth\config
CONFIG_ROOT=./config

# 容器內程序的使用者。設成擁有 DATA_ROOT 的宿主帳號，硬鏈接兩端的擁有者才一致。
# Linux 上用 `id -u` 與 `id -g` 查；Windows 的 bind mount 沒有這個概念，維持預設即可。
PUID=1000
PGID=1000

# 新檔案的權限遮罩。022 = 檔案 644、目錄 755（TRaSH 的建議值）。
UMASK=022

# 容器的時區，影響 log 與排程時間。
TZ=Asia/Taipei

# 要一起啟動的服務。已經有其中某個服務的人把它從這裡拿掉，改在精靈裡填連線資訊；
# berth 自己沒有 profile，永遠會啟動。
COMPOSE_PROFILES=jellyfin,qbittorrent,prowlarr
